---
// Fotoraster mit Vollbildansicht (Lightbox). Ohne JavaScript öffnet ein Klick das Bild direkt.
import { Image, getImage } from 'astro:assets';
const { fotos, galerieId = 'galerie' } = Astro.props;
const gross = await Promise.all(fotos.map((f) => getImage({ src: f.bild, width: 1600, format: 'webp' })));
---
<ul class="raster" data-galerie={galerieId}>
  {fotos.map((f, i) => (
    <li>
      <a href={gross[i].src} data-index={i} data-alt={f.alt}>
        <Image src={f.bild} alt={f.alt} widths={[320, 480, 640]} sizes="(max-width: 600px) 50vw, 300px" loading="lazy" />
      </a>
    </li>
  ))}
</ul>

<dialog class="lightbox" aria-label="Fotoansicht">
  <img alt="" />
  <p class="zaehler" aria-live="polite"></p>
  <button class="zu" aria-label="Schließen">✕</button>
  <button class="zurueck" aria-label="Vorheriges Foto">‹</button>
  <button class="weiter" aria-label="Nächstes Foto">›</button>
</dialog>

<script>
  document.querySelectorAll('[data-galerie]').forEach((raster) => {
    const dlg = raster.nextElementSibling;
    const img = dlg.querySelector('img');
    const zaehler = dlg.querySelector('.zaehler');
    const links = [...raster.querySelectorAll('a')];
    let i = 0;
    const zeige = (n) => {
      i = (n + links.length) % links.length;
      img.src = links[i].href; img.alt = links[i].dataset.alt;
      zaehler.textContent = `${i + 1} / ${links.length}`;
    };
    links.forEach((a, n) => a.addEventListener('click', (e) => { e.preventDefault(); zeige(n); dlg.showModal(); }));
    dlg.querySelector('.zu').onclick = () => dlg.close();
    dlg.querySelector('.zurueck').onclick = () => zeige(i - 1);
    dlg.querySelector('.weiter').onclick = () => zeige(i + 1);
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') zeige(i - 1); if (e.key === 'ArrowRight') zeige(i + 1); });
    let x0 = null;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => { if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) zeige(i + (dx < 0 ? 1 : -1)); x0 = null; });
  });
</script>

<style>
  .raster { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(180px, 45%), 1fr)); gap: 8px; }
  .raster a { display: block; border-radius: 8px; overflow: hidden; aspect-ratio: 3 / 2; background: var(--linie); }
  .raster img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  .raster a:hover img { transform: scale(1.04); }
  .lightbox { border: 0; padding: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; background: rgba(20, 12, 8, .94); color: #fff; }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox img { max-width: calc(100vw - 32px); max-height: calc(100dvh - 120px); object-fit: contain; border-radius: 6px; }
  .lightbox button { position: absolute; width: 52px; height: 52px; border-radius: 50%; border: 0; background: rgba(255, 255, 255, .14); color: #fff; font-size: 1.8rem; cursor: pointer; }
  .lightbox button:hover { background: rgba(255, 255, 255, .28); }
  .zu { top: 16px; right: 16px; font-size: 1.2rem !important; }
  .zurueck { left: 16px; top: 50%; translate: 0 -50%; }
  .weiter { right: 16px; top: 50%; translate: 0 -50%; }
  .zaehler { position: absolute; bottom: 20px; left: 0; right: 0; text-align: center; font-size: .95rem; }
  @media (max-width: 600px) { .zurueck, .weiter { top: auto; bottom: 12px; translate: none; } }
</style>
